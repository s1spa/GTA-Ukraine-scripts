<Window x:Class="ScriptedWpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        mc:Ignorable="d"
        Title="GTA Ukraine Scripts"
        Height="680" Width="1050"
        MinHeight="520" MinWidth="750"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <!-- Sidebar button style -->
        <Style x:Key="SidebarButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="44"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Padding" Value="16,0,16,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}"
                                BorderThickness="0" CornerRadius="6" Margin="6,1">
                            <Border x:Name="AccentBar" BorderThickness="2,0,0,0"
                                    BorderBrush="Transparent" CornerRadius="2">
                                <ContentPresenter VerticalAlignment="Center"
                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#18FFFFFF"/>
                                <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Background="{StaticResource BgBaseBrush}" CornerRadius="10"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>   <!-- title bar -->
                <RowDefinition Height="*"/>    <!-- content -->
                <RowDefinition Height="160"/>  <!-- terminal -->
            </Grid.RowDefinitions>

            <!-- ====== TITLE BAR ====== -->
            <Border Grid.Row="0" Background="{StaticResource BgPanelBrush}"
                    CornerRadius="10,10,0,0" MouseLeftButtonDown="TitleBar_MouseDown">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <!-- Logo diamond -->
                        <Path Data="M8,0 L16,8 L8,16 L0,8 Z" Fill="{StaticResource AccentBrush}"
                              Width="14" Height="14" Stretch="Fill" Margin="0,0,8,0"/>
                        <TextBlock Text="GTA Ukraine" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <TextBlock Text="Scripts" FontSize="13" FontWeight="Light"
                                   Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"
                                   Margin="5,0,0,0"/>
                    </StackPanel>

                    <!-- Window buttons -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button x:Name="MinBtn" Content="&#x2212;" Width="32" Height="28"
                                Style="{StaticResource SidebarButtonStyle}"
                                Padding="0" HorizontalContentAlignment="Center"
                                Click="MinBtn_Click"/>
                        <Button x:Name="CloseBtn" Content="&#x2715;" Width="32" Height="28"
                                Style="{StaticResource SidebarButtonStyle}"
                                Padding="0" HorizontalContentAlignment="Center"
                                Click="CloseBtn_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ====== MAIN CONTENT ====== -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>   <!-- sidebar -->
                    <ColumnDefinition Width="1"/>     <!-- divider -->
                    <ColumnDefinition Width="*"/>     <!-- detail -->
                </Grid.ColumnDefinitions>

                <!-- SIDEBAR -->
                <Border Grid.Column="0" Background="{StaticResource BgPanelBrush}">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="&#x2022; MODULES"
                                   FontSize="9" FontWeight="Bold"
                                   Foreground="{StaticResource TextDimBrush}"
                                   Margin="18,14,0,6"/>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="SidebarPanel"/>
                        </ScrollViewer>
                    </DockPanel>
                </Border>

                <!-- Vertical divider -->
                <Rectangle Grid.Column="1" Fill="{StaticResource BorderBrush}"/>

                <!-- DETAIL AREA -->
                <Border Grid.Column="2" Background="{StaticResource BgBaseBrush}">
                    <ContentPresenter x:Name="DetailContent"/>
                </Border>
            </Grid>

            <!-- Horizontal divider -->
            <Rectangle Grid.Row="1" VerticalAlignment="Bottom" Height="1"
                       Fill="{StaticResource BorderBrush}"/>

            <!-- ====== TERMINAL ====== -->
            <Border Grid.Row="2" Background="{StaticResource BgPanelBrush}">
                <DockPanel>
                    <!-- Terminal header -->
                    <Border DockPanel.Dock="Top" Height="30" BorderThickness="0,0,0,1"
                            BorderBrush="{StaticResource BorderBrush}">
                        <DockPanel Margin="14,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="TERMINAL" FontSize="9" FontWeight="Bold"
                                           Foreground="{StaticResource TextDimBrush}"/>
                                <Border Background="#1A4CFF72" CornerRadius="3" Margin="8,0,0,0" Padding="4,1">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse Width="5" Height="5" Fill="{StaticResource AccentBrush}"
                                                 Margin="0,0,3,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="LIVE" FontSize="8" FontWeight="Bold"
                                                   Foreground="{StaticResource AccentBrush}"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                            <Button DockPanel.Dock="Right" Content="CLR" HorizontalAlignment="Right"
                                    Style="{StaticResource SidebarButtonStyle}"
                                    Height="22" Padding="8,0"
                                    FontSize="9" FontWeight="Bold"
                                    Foreground="{StaticResource TextDimBrush}"
                                    Click="ClearTerminal_Click"/>
                        </DockPanel>
                    </Border>

                    <!-- Terminal output -->
                    <RichTextBox x:Name="TerminalBox"
                                 Background="Transparent"
                                 Foreground="{StaticResource TextSecondaryBrush}"
                                 BorderThickness="0"
                                 IsReadOnly="True"
                                 VerticalScrollBarVisibility="Auto"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 Padding="14,6"
                                 materialDesign:HintAssist.Hint=""/>
                </DockPanel>
            </Border>
        </Grid>
    </Border>
</Window>
