<Application x:Class="ScriptedWpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ScriptedWpf"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <materialDesign:BundledTheme BaseTheme="Dark"
                                             PrimaryColor="Green"
                                             SecondaryColor="LightGreen" />
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="AccentBrush"        Color="#4CFF72"/>
            <SolidColorBrush x:Key="BgBaseBrush"        Color="#0D0D0F"/>
            <SolidColorBrush x:Key="BgPanelBrush"       Color="#13131A"/>
            <SolidColorBrush x:Key="BgCardBrush"        Color="#1A1A24"/>
            <SolidColorBrush x:Key="BorderBrush"        Color="#2A2A38"/>
            <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#E8E8F0"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8888AA"/>
            <SolidColorBrush x:Key="TextDimBrush"       Color="#55556A"/>

            <!-- Інпути: світлий текст на темному фоні -->
            <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
                <Setter Property="Foreground"        Value="#E8E8F0"/>
                <Setter Property="Background"        Value="#1A1A24"/>
                <Setter Property="BorderBrush"       Value="#2A2A38"/>
                <Setter Property="CaretBrush"        Value="#4CFF72"/>
                <Setter Property="FontSize"          Value="13"/>
            </Style>

            <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
                <Setter Property="Foreground"        Value="#E8E8F0"/>
                <Setter Property="Background"        Value="#1A1A24"/>
                <Setter Property="BorderBrush"       Value="#2A2A38"/>
                <Setter Property="FontSize"          Value="13"/>
            </Style>

            <Style TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
                <Setter Property="Foreground"        Value="#8888AA"/>
                <Setter Property="FontSize"          Value="13"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
