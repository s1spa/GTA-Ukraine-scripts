<Application x:Class="ScriptedWpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:ScriptedWpf"
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 1. Тема MD -->
                <materialDesign:BundledTheme BaseTheme="Dark"
                                             PrimaryColor="Green"
                                             SecondaryColor="LightGreen" />
                <!-- 2. MD стилі (CheckBox тощо) -->
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml" />
                <!-- 3. Наші стилі — перекривають TextBox/ComboBox від MD -->
                <ResourceDictionary Source="pack://application:,,,/steamwebhelper;component/Themes/InputStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="AccentBrush"        Color="#4CFF72"/>
            <SolidColorBrush x:Key="BgBaseBrush"        Color="#0D0D0F"/>
            <SolidColorBrush x:Key="BgPanelBrush"       Color="#13131A"/>
            <SolidColorBrush x:Key="BgCardBrush"        Color="#1A1A24"/>
            <SolidColorBrush x:Key="BorderBrush"        Color="#2A2A38"/>
            <SolidColorBrush x:Key="TextPrimaryBrush"   Color="#E8E8F0"/>
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#8888AA"/>
            <SolidColorBrush x:Key="TextDimBrush"       Color="#55556A"/>

            <Style TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
                <Setter Property="Foreground"  Value="#8888AA"/>
                <Setter Property="FontSize"    Value="13"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
